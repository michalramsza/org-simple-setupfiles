# Disable default Org HTML CSS JS
#+OPTIONS: html-style:nil
#+OPTIONS: html-scripts:t

# Additional options
#+OPTIONS: toc:nil num:nil html-postamble:nil
#+EXCLUDE_TAGS: noexport


#+HTML_HEAD: <style>
#+HTML_HEAD:   /* Reset & Base Styles */
#+HTML_HEAD:   body {
#+HTML_HEAD:     font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji';
#+HTML_HEAD:     line-height: 1.5;
#+HTML_HEAD:     color: #24292e;
#+HTML_HEAD:     background-color: #fff;
#+HTML_HEAD:     max-width: 1200px;
#+HTML_HEAD:     margin: 0 auto;
#+HTML_HEAD:     padding: 20px;
#+HTML_HEAD:   }
#+HTML_HEAD:   /* Top-level sections */
#+HTML_HEAD:   .outline-2 {
#+HTML_HEAD:     background-color: #f6f8fa;
#+HTML_HEAD:     border: 1px solid #d1d5da;
#+HTML_HEAD:     border-radius: 6px;
#+HTML_HEAD:     padding: 16px;
#+HTML_HEAD:     margin-bottom: 16px;
#+HTML_HEAD:     display: flex !important;
#+HTML_HEAD:     flex-wrap: wrap !important;
#+HTML_HEAD:     justify-content: center !important;
#+HTML_HEAD:     gap: 2% !important;
#+HTML_HEAD:   }
#+HTML_HEAD:   /* Fix for the heading and initial text in outline-2 to be full width */
#+HTML_HEAD:   .outline-2 h2, .outline-text-2 {
#+HTML_HEAD:     width: 100% !important;
#+HTML_HEAD:     flex: 0 0 100% !important;
#+HTML_HEAD:   }
#+HTML_HEAD:   /* Second-level sections as reflowing blocks */
#+HTML_HEAD:   .outline-3 {
#+HTML_HEAD:     background-color: #fff;
#+HTML_HEAD:     border: 1px solid #d1d5da;
#+HTML_HEAD:     border-radius: 6px;
#+HTML_HEAD:     padding: 16px;
#+HTML_HEAD:     margin-bottom: 16px;
#+HTML_HEAD:     width: 48% !important;
#+HTML_HEAD:     box-sizing: border-box;
#+HTML_HEAD:     display: block !important;
#+HTML_HEAD:   }
#+HTML_HEAD:   /* Disable the previous wrapper styling as it is not the direct parent */
#+HTML_HEAD:   .outline-text-2 {
#+HTML_HEAD:     display: block !important;
#+HTML_HEAD:   }
#+HTML_HEAD:   /* Ensure the title and other elements stay full width */
#+HTML_HEAD:   .title {
#+HTML_HEAD:     width: 100%;
#+HTML_HEAD:     display: block;
#+HTML_HEAD:   }
#+HTML_HEAD:   .outline-2 h2, .outline-2 h3, .outline-2 h4, .outline-2 h5, .outline-2 h6 {
#+HTML_HEAD:     color: #24292e;
#+HTML_HEAD:     margin-top: 0;
#+HTML_HEAD:     margin-bottom: 0.5em;
#+HTML_HEAD:     font-weight: 600;
#+HTML_HEAD:   }
#+HTML_HEAD:   .outline-2 h2 { border-bottom: 1px solid #d1d5da; padding-bottom: 0.3em; }
#+HTML_HEAD:   .outline-2 h3 { border-bottom: 1px solid #eee; padding-bottom: 0.2em; }
#+HTML_HEAD:   /* Links */
#+HTML_HEAD:   a {
#+HTML_HEAD:     color: #0366d6;
#+HTML_HEAD:     text-decoration: none;
#+HTML_HEAD:   }
#+HTML_HEAD:   a:hover {
#+HTML_HEAD:     text-decoration: underline;
#+HTML_HEAD:   }
#+HTML_HEAD:   /* Code Blocks */
#+HTML_HEAD:   pre {
#+HTML_HEAD:     background-color: #e9ecef;
#+HTML_HEAD:     border: 1px solid #d1d5da;
#+HTML_HEAD:     border-radius: 6px;
#+HTML_HEAD:     padding: 16px;
#+HTML_HEAD:     overflow-x: auto;
#+HTML_HEAD:     font-size: 0.9em;
#+HTML_HEAD:   }
#+HTML_HEAD:   code {
#+HTML_HEAD:     font-family: SFMono-Regular, Consolas, 'Liberation Mono', Menlo, Courier, monospace;
#+HTML_HEAD:     background-color: #e9ecef;
#+HTML_HEAD:     padding: 0.2em 0.4em;
#+HTML_HEAD:     border-radius: 3px;
#+HTML_HEAD:     font-size: 0.9em;
#+HTML_HEAD:   }
#+HTML_HEAD:   /* Lists */
#+HTML_HEAD:   ul, ol {
#+HTML_HEAD:     padding-left: 2em;
#+HTML_HEAD:   }
#+HTML_HEAD:   li {
#+HTML_HEAD:     margin-bottom: 0.25em;
#+HTML_HEAD:   }
#+HTML_HEAD:   /* Tables */
#+HTML_HEAD:   table {
#+HTML_HEAD:     border-spacing: 0;
#+HTML_HEAD:     border-collapse: collapse;
#+HTML_HEAD:     width: 100%;
#+HTML_HEAD:     margin: 16px 0;
#+HTML_HEAD:   }
#+HTML_HEAD:   th, td {
#+HTML_HEAD:     padding: 6px 13px;
#+HTML_HEAD:     border: 1px solid #dfe2e5;
#+HTML_HEAD:   }
#+HTML_HEAD:   th {
#+HTML_HEAD:     background-color: #e6f7ff;
#+HTML_HEAD:     font-weight: 600;
#+HTML_HEAD:   }
#+HTML_HEAD:   tbody tr:nth-child(odd) {
#+HTML_HEAD:     background-color: #f0f9ff;
#+HTML_HEAD:   }
#+HTML_HEAD:   /* Blockquote */
#+HTML_HEAD:   blockquote {
#+HTML_HEAD:     padding: 0 1em;
#+HTML_HEAD:     color: #6a737d;
#+HTML_HEAD:     border-left: 4px solid #dfe2e5;
#+HTML_HEAD:     margin: 0 0 16px;
#+HTML_HEAD:   }
#+HTML_HEAD:   /* Horizontal Rule */
#+HTML_HEAD:   hr {
#+HTML_HEAD:     height: 0;
#+HTML_HEAD:     margin: 24px 0;
#+HTML_HEAD:     background-color: #e1e4e8;
#+HTML_HEAD:     border: 0;
#+HTML_HEAD:   }
#+HTML_HEAD:   .figure p:first-child {
#+HTML_HEAD:     text-align: center;
#+HTML_HEAD: }
#+HTML_HEAD:   .figure p:first-child img {
#+HTML_HEAD:     display: block;
#+HTML_HEAD:     max-width: 100%;
#+HTML_HEAD:     height: auto;
#+HTML_HEAD:     margin-left: auto;
#+HTML_HEAD:     margin-right: auto;
#+HTML_HEAD: }
#+HTML_HEAD:   .figure p:last-child {
#+HTML_HEAD:     width: 80%;
#+HTML_HEAD:     margin: 0 auto;
#+HTML_HEAD:     font-style: italic;
#+HTML_HEAD:     text-align: justify;
#+HTML_HEAD:     color: #586069;
#+HTML_HEAD: }
#+HTML_HEAD: </style>
#+HTML_HEAD: <script>
#+HTML_HEAD:   document.addEventListener('DOMContentLoaded', function () {
#+HTML_HEAD:     // Select all <pre> elements (code blocks)
#+HTML_HEAD:     const blocks = document.querySelectorAll('pre');
#+HTML_HEAD:     blocks.forEach(function (block) {
#+HTML_HEAD:       block.style.cursor = 'pointer';
#+HTML_HEAD:       block.title = 'Click to copy';
#+HTML_HEAD:       block.addEventListener('click', function () {
#+HTML_HEAD:         const text = block.innerText || block.textContent;
#+HTML_HEAD:         navigator.clipboard.writeText(text).then(function () {
#+HTML_HEAD:           // Optional: flash background to indicate success
#+HTML_HEAD:           const original = block.style.backgroundColor;
#+HTML_HEAD:           block.style.backgroundColor = '#FFC8DD'; // flash color
#+HTML_HEAD:           setTimeout(function () {
#+HTML_HEAD:             block.style.backgroundColor = original;
#+HTML_HEAD:           }, 200);
#+HTML_HEAD:         }).catch(function (err) {
#+HTML_HEAD:           console.error('Failed to copy: ', err);
#+HTML_HEAD:         });
#+HTML_HEAD:       });
#+HTML_HEAD:     });
#+HTML_HEAD:   });
#+HTML_HEAD: </script>